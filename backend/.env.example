# BloomCycle Backend — copy to .env and fill in values

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/bloomcycle

# JWT
JWT_SECRET=super-secret-change-in-production-min-32-chars

# Anthropic API (for Bloom AI agent)
ANTHROPIC_API_KEY=sk-ant-...

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
